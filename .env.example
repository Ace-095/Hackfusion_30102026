# Run the interface with a fresh local database (default: .canarygate/fixture.sqlite3)
CANARYGATE_DB_PATH=.canarygate/canarygate.sqlite3

# Required before any TargetLab workflow. Path to the pinned test certificate.
# The lab (python -m targetlab --tls-cert ... --tls-key ...) must be running on 127.0.0.1.
CANARYGATE_TARGETLAB_CA=tests/fixtures/tls/targetlab-cert.pem

# These variables are read directly from the process environment. There is no
# .env loader and no secret belongs in this file: the repository contains no
# credentials, and the test certificate is a public local fixture.
